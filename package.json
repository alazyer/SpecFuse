{
  "name": "specfuse",
  "version": "4.0.0",
  "description": "Self-contained Spec-Driven Development platform — plan, specify, change, and sync without external tools.",
  "type": "module",
  "bin": {
    "specfuse": "./bin/specfuse.js"
  },
  "exports": {
    ".": "./src/api.mjs",
    "./api.mjs": "./src/api.mjs",
    "./api/batch.mjs": "./src/api/batch.mjs",
    "./api/bundle.mjs": "./src/api/bundle.mjs",
    "./api/change.mjs": "./src/api/change.mjs",
    "./api/ci.mjs": "./src/api/ci.mjs",
    "./api/clean.mjs": "./src/api/clean.mjs",
    "./api/config.mjs": "./src/api/config.mjs",
    "./api/errors.mjs": "./src/api/errors.mjs",
    "./api/graph.mjs": "./src/api/graph.mjs",
    "./api/history.mjs": "./src/api/history.mjs",
    "./api/lint.mjs": "./src/api/lint.mjs",
    "./api/plan.mjs": "./src/api/plan.mjs",
    "./api/schema.mjs": "./src/api/schema.mjs",
    "./api/specify.mjs": "./src/api/specify.mjs",
    "./api/sync-ops.mjs": "./src/api/sync-ops.mjs",
    "./api/template.mjs": "./src/api/template.mjs",
    "./api/utils.mjs": "./src/api/utils.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node bin/specfuse.js",
    "test": "node --test src/tests/*.test.js",
    "test:coverage": "c8 --check-coverage --reporter=text --reporter=lcov node --test src/tests/*.test.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "diff": "^7.0.0",
    "gray-matter": "^4.0.3",
    "micromatch": "^4.0.0",
    "archiver": "^7.0.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0"
  },
  "keywords": [
    "sdd",
    "spec-driven-development",
    "planning",
    "architecture",
    "change-management",
    "constitution"
  ],
  "license": "MIT"
}
