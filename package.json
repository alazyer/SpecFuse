{
  "name": "specfuse",
  "version": "3.0.0",
  "description": "Self-contained Spec-Driven Development platform — plan, specify, change, and sync without external tools.",
  "type": "module",
  "bin": {
    "specfuse": "./bin/specfuse.js"
  },
  "exports": {
    ".": "./src/api.mjs",
    "./api.mjs": "./src/api.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node bin/specfuse.js",
    "test": "node --test src/tests/*.test.js"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "diff": "^7.0.0",
    "gray-matter": "^4.0.3"
  },
  "keywords": [
    "sdd",
    "spec-driven-development",
    "planning",
    "architecture",
    "change-management",
    "constitution"
  ],
  "license": "MIT"
}
